# API base URL for the backend (e.g., http://localhost:8000 or https://dsp.tataelxsi.com)
# Do not include trailing slash.
REACT_APP_API_BASE_URL=http://localhost:8000

# Endpoint paths (concatenated to base URL)
# Can be absolute paths starting with /, or full URLs (https://...) if needed.
REACT_APP_AUTH_LOGIN_ENDPOINT=/auth/login
REACT_APP_AUTH_SIGNUP_ENDPOINT=/auth/signup
REACT_APP_PROMPT_ENDPOINT=/prompt

# Use mock API instead of real backend ("true" or "false")
REACT_APP_USE_MOCK_API=true

# If backend uses cookies/sessions and requires credentials, enable this.
# For token-based auth (default), leave false.
REACT_APP_WITH_CREDENTIALS=false

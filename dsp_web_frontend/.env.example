# Base API URL used by the frontend to contact the backend (no trailing slash)
REACT_APP_API_BASE_URL=http://localhost:8000

# Auth endpoints
REACT_APP_AUTH_LOGIN_ENDPOINT=/auth/login
REACT_APP_AUTH_SIGNUP_ENDPOINT=/auth/signup

# Prompt endpoint
REACT_APP_PROMPT_ENDPOINT=/prompt

# Health endpoint (used by NavBar health indicator)
REACT_APP_HEALTH_ENDPOINT=/api/health

# Optional: include credentials (cookies) for CORS requests if your backend requires it
# Set to "true" to include; default is "false"
REACT_APP_WITH_CREDENTIALS=false

# Optional: use mock API (no backend required)
# Set to "true" to enable full frontend-only demo mode.
REACT_APP_USE_MOCK_API=false

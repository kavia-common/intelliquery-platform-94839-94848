# Server port (default: 8000)
PORT=8000

# JWT secret used to sign tokens (REQUIRED in production)
JWT_SECRET=change_this_to_a_long_random_secret

# Optional: override default database file path (default: ./data/app.db)
#DATABASE_URL=./data/app.db

# Frontend origin allowed by CORS (will default to http://localhost:3000 and preview origin)
#FRONTEND_ORIGIN=http://localhost:3000

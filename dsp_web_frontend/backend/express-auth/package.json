{
  "name": "express-auth-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal Express backend with SQLite, bcrypt, and JWT for signup/login compatible with the DSP Web Frontend.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "init-db": "node src/db.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
